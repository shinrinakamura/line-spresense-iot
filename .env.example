
# ========================================
# Node-REDの管理者認証
# ========================================

# Node-RED編集画面にログインするユーザー名
NODE_RED_ADMIN_USER=admin

# 管理者パスワードのbcryptハッシュ値
# 初期設定スクリプトで生成する
NODE_RED_ADMIN_PASSWORD_HASH=

# ========================================
# Node-REDの認証情報暗号化
# ========================================

# フロー内の認証情報を暗号化するための秘密鍵
# 初期設定スクリプトでランダム生成する
NODE_RED_CREDENTIAL_SECRET=

# ========================================
# LINEの認証情報
# ========================================
# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_ALLOWED_USER_ID=