# ========================================
# Node.js関連
# ========================================

# npmでインストールしたライブラリをGitの管理対象から除外する
# ライブラリはpackage.jsonなどを使って再インストールできる
node_modules/


# ========================================
# パスワード・認証情報などの秘密情報
# ========================================

# パスワードやAPIトークンを保存する.envファイルを除外する
.env

# .env.localなど、環境ごとの設定ファイルも除外する
.env.*

# 設定項目の見本となる.env.exampleだけはGitで管理する
# 実際のパスワードやAPIトークンは記載しない
!.env.example


# ========================================
# Node-REDの認証情報・ローカル設定
# ========================================

# Node-REDのノードが使用する認証情報ファイルを除外する
# MQTTの接続パスワードなどが保存される場合がある
node-red/*_cred.json

# Node-REDが自動生成するローカル設定ファイルを除外する
node-red/.config.*

# Node-REDのセッション情報を除外する
node-red/.sessions.json

# Node-REDが自動生成するバックアップファイル
node-red/*.backup

# 開発環境固有のNode-REDフロー
node-red/flows.json